# ── Supabase (required) ──
# Service-role key — NOT the anon key. The agents write to all tables.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Anthropic (required for injury/weather/power/public-splits agents) ──
ANTHROPIC_API_KEY=sk-ant-...
# Optional: comma-separated model-detection order. The system probes each on
# startup and uses the first your key can call. Default leads with the cheapest
# capable model to control cost: claude-haiku-4-5,claude-sonnet-4-6,claude-3-5-sonnet-20241022,claude-3-haiku-20240307
# Set a stronger model explicitly if you want it (and watch the bill):
# ANTHROPIC_MODELS=claude-sonnet-4-6,claude-haiku-4-5

# ── The Odds API (required for odds agent) ──
ODDS_API_KEY=...
# free = 500 req/mo, starter = 20k, pro = 5M. Controls the monthly request budget.
ODDS_API_TIER=free

# ── Alerts: SMS and/or Email (both optional; instant qualifying-play alerts) ──
# Twilio SMS (per-message cost + US A2P 10DLC registration):
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+15551234567
# ALERT_NUMBERS=+15557654321               # comma-separated recipients

# Email (FREE via Gmail or any SMTP — recommended). For Gmail: create an
# "App Password" (Google Account -> Security -> 2-Step Verification -> App passwords)
# and use it as SMTP_PASS. Host smtp.gmail.com, port 465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=you@gmail.com                  # optional, defaults to SMTP_USER
# ALERT_EMAILS=you@gmail.com,partner@x.com # comma-separated recipients

# ── Server ──
PORT=8080
# Comma-separated origins allowed to call /health, /plays, /feed (CORS).
CORS_ORIGINS=https://blake27w.github.io

# ── Tuning (all optional) ──
# CONFIDENCE_FLOOR=70
# UNIT_DOLLARS=12
# DRY_RUN=false           # when true, agents compute but skip external writes/SMS

# Per-agent run interval in MINUTES (overrides the defaults). Raise the
# Claude-backed ones to cut cost. Defaults: injury 30, weather 45, power 60,
# public-splits 30, mlb-context 60, prop-engine 15, grading 30, clv 15;
# odds 5, sharp 2, schedule-spot 30, signal 5.
# INTERVAL_INJURY=30
# INTERVAL_WEATHER=45
# INTERVAL_PUBLIC_SPLITS=480
# INTERVAL_MLB_CONTEXT=60
# INTERVAL_GRADING=30

# Power ratings (free Elo) run on a clock: default Mon & Thu 08:00 ET.
# POWER_TIMES=08:00
# POWER_DAYS=1,4                  # 0=Sun..6=Sat; e.g. 1 = Mondays only

# Prop engine (free Odds-API props) caps — bound Odds quota usage.
# PROP_MAX_GAMES_PER_RUN=6
# PROP_MAX_SCANS_PER_DAY=40

# ── Odds budget: share SHAPE and denominator MEMBERSHIP ──
# A per-sport ceiling is `budget x 0.85 x share / sumAlloc`, where sumAlloc sums
# the shares of the sports in the DENOMINATOR. The two halves are configured
# differently on purpose:
#
#   SHAPE is env-tuned. ODDS_ALLOC_<SPORT> overrides that sport's share (any
#   non-negative number; they need not sum to 1). Sports: NFL NCAAF MLB NBA
#   NCAAB NHL SOCCER UFC BOXING WNBA TENNIS GOLF. Read per call, so a change
#   needs no restart. Winter shape (D86), for reference:
# ODDS_ALLOC_NFL=0.26   ODDS_ALLOC_NCAAF=0.13   ODDS_ALLOC_MLB=0.02
# ODDS_ALLOC_NBA=0.22   ODDS_ALLOC_NCAAB=0.14   ODDS_ALLOC_NHL=0.14
#
#   MEMBERSHIP is DERIVED and should not need tuning: a sport leaves the
#   denominator after this many consecutive OBSERVED quiet days on the free
#   /sports feed (entry is immediate on one active observation). Default 14,
#   FLOORED AT 7 — a smaller value releases live sports and recreates D6, where
#   football left the denominator on a Tuesday and every other ceiling inflated.
#   Raise it to strand credits more conservatively; you cannot lower it past 7.
# ODDS_SEASON_GRACE_DAYS=14

# ── Post-tip polling tail (D102) ────────────────────────────────
# How long a sport stays on the fast STRIKE/NEAR cadence AFTER a game has
# started. Two values, because only some sports have an in-play consumer:
#
#   ODDS_LIVE_SPORTS — comma-separated sports that keep the FULL -3.5h tail.
#   Defaults to NFL when NFL_LIVE=true (exactly 'true', matching the nfl.live
#   agent's own gate — NFL_LIVE=1 does NOT enable it, there or here), and to
#   nothing otherwise. Add a sport here the day it gets a live consumer.
#   Names are upper-cased and checked against the known sports; anything else
#   is dropped with a warning at startup (a plain typo bought nothing before).
#
#   ODDS_POSTTIP_MIN — the tail for every OTHER sport, in minutes. Default 45:
#   enough for book-move's freshest started games and one of sharp's 35-minute
#   steam windows, and no more. Setting 0 is honoured and means "drop to
#   MID/IDLE the moment a game tips". Anything above 210 is CLAMPED to 210 (the
#   full tail) with a warning — a non-live sport must never poll longer than
#   the window this change removed. A blank, negative or non-integer value is
#   rejected with a warning and the 45 stands.
#
#   Past the tail, post-tip steam for a non-live sport is undetectable by
#   construction (its gaps exceed sharp's 35-minute bound). That is the trade,
#   and sharp reports it per run — `N started games beyond steam bound
#   (post-tip tail)` — so it never reads as a quiet market.
# ODDS_LIVE_SPORTS=NFL
# ODDS_POSTTIP_MIN=45
